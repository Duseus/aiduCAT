// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`run card renderer snapshots > collapses consecutive tools while preserving the latest running tool 1`] = `
{
  "body": {
    "elements": [
      {
        "content": "🫧Poping…",
        "tag": "markdown",
      },
      {
        "border": {
          "color": "grey",
          "corner_radius": "5px",
        },
        "elements": [
          {
            "content": "- 👩🏻‍🔧 **Edit** — /repo/a.ts
- 👩🏻‍🏫 **Read** — /repo/a.ts
- 👩🏻‍💻 **Bash** — pwd",
            "tag": "markdown",
            "text_size": "notation",
          },
        ],
        "expanded": false,
        "header": {
          "icon": {
            "size": "16px 16px",
            "tag": "standard_icon",
            "token": "down-small-ccm_outlined",
          },
          "icon_expanded_angle": -180,
          "icon_position": "right",
          "title": {
            "content": "🧠  1 轮 · 🛠️  3 个工具 · ⏳  0.0 秒",
            "tag": "markdown",
            "text_size": "notation",
          },
          "vertical_align": "center",
        },
        "padding": "8px 8px 8px 8px",
        "tag": "collapsible_panel",
        "vertical_spacing": "8px",
      },
    ],
  },
  "config": {
    "streaming_mode": true,
    "summary": {
      "content": "🫧Poping…",
    },
    "wide_screen_mode": true,
  },
  "header": {
    "template": "blue",
    "title": {
      "content": "💭 处理中... ⚡ 改文件",
      "tag": "plain_text",
    },
  },
  "schema": "2.0",
}
`;

